# 生产构建禁止 Mock 免登（必须为 false 或删除）
VITE_MOCK_AUTH=false

# === Mock 数据总开关（生产默认关闭） ===
VITE_USE_MOCK=false

# 真实后端 baseURL
VITE_REAL_BASE_URL=http://xdd.ztk1.com/
VITE_APP_BASE_URL=http://xdd.ztk1.com/

# H5 内嵌完整 PC 后台（与线上管理端同域部署时填实际域名，无尾斜杠）
VITE_PC_ADMIN_ORIGIN=
VITE_H5_ENTRY_PC=false
VITE_H5_ENTRY_PC_HASH=/index
