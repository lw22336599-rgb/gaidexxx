# Mock 登录免登开关（VITE_MOCK_AUTH，仅影响登录页 mock 直通）
VITE_MOCK_AUTH=false

# === Mock 数据总开关 ===
VITE_USE_MOCK=false

# H5 dev server：0.0.0.0 便于局域网任意网卡 IP 访问
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173
VITE_DEV_BIND_POLICY=192168_first
VITE_LAN_ENTRY_HOST=10.10.10.177

# 手机 H5：登录等接口固定经 PC Vite，再代理到 bridge（与 PC axios 开发环境一致）
VITE_UNI_FORCE_API_BASE=http://10.10.10.177:5200
VITE_UNI_FORCE_BRIDGE_BASE=http://10.10.10.177:3000

# 5173 dev 代理 → bridge（与手机/PC 联调 IP 一致）
VITE_PROXY_TARGET=http://10.10.10.177:3000/
VITE_MOCK_BASE_URL=http://10.10.10.177:3000/

VITE_DEV_API_BASE=http://10.10.10.177:5200
VITE_REAL_BASE_URL=http://10.10.10.177:5200/
VITE_APP_BASE_URL=http://10.10.10.177:5200/

VITE_PC_ADMIN_ORIGIN=http://10.10.10.177:5200
VITE_H5_ENTRY_PC=false
VITE_H5_ENTRY_PC_HASH=/index

API_BRIDGE_PORT=3000
API_BRIDGE_BIND=0.0.0.0
API_BRIDGE_LAN_HOST=10.10.10.177

# 上游不可达时改 mock，保证 H5/微信登录联调可立即返回 200（需真实后端时再改 real）
API_BRIDGE_MODE=mock
API_UPSTREAM=http://120.24.48.102:5265/

API_BRIDGE_UPSTREAM_TIMEOUT=30000
API_BRIDGE_UPSTREAM_TIMEOUT_LONG=60000
API_BRIDGE_FALLBACK=true
API_BRIDGE_LOG_API=true
# 可选：api-dev-bridge 额外 CORS 白名单（逗号或空格分隔 Origin，临时未命中仍回 *）
# API_BRIDGE_CORS_WHITELIST=http://192.168.1.8:5173

