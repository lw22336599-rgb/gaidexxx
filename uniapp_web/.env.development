# Mock 登录（true 时：默认测试号不走真实接口；免登链接见 README/交付说明）
VITE_MOCK_AUTH=true

# H5 开发：浏览器请求同源 /proxy/*，由 Vite 转发到 VITE_PROXY_TARGET（避免 CORS）
VITE_APP_BASE_URL=/proxy

# Vite 将 /proxy 转发到本机 API 桥（见 scripts/api-dev-bridge.mjs）
VITE_PROXY_TARGET=http://127.0.0.1:5265/

# 真实后端根（与 faster-move-web/docs/ServiceHttp.cs Release 一致；可改为你的内网/VPN 地址）
API_UPSTREAM=http://120.24.48.102:5265/
