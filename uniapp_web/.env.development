# ============================================================
# uni-app H5 / 小程序 开发环境配置
# 修改后需重启 dev:h5 / restart:pc-stack
# ============================================================

# Mock 登录免登开关（true = 任意账号直接进首页，用于 UI 调试）
VITE_MOCK_AUTH=false

# Mock 数据总开关（true = uni.request 走 bridge 种子数据；false = 真实后端）
VITE_USE_MOCK=false

# H5 dev server 绑定（0.0.0.0 = 局域网任意 IP 均可访问）
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173
VITE_DEV_BIND_POLICY=192168_first
VITE_LAN_ENTRY_HOST=10.10.10.177

# ============================================================
# 接口基址：所有 uni.request 均走 PC Vite :5200 代理链
# 手机端只需与 PC 同局域网，打开 http://10.10.10.177:5200 即可
# ============================================================
VITE_UNI_FORCE_API_BASE=http://10.10.10.177:5200
VITE_UNI_FORCE_BRIDGE_BASE=http://10.10.10.177:5200

# 5173 dev 代理目标：指向 PC Vite (5200 再代理到 bridge:3000)
VITE_PROXY_TARGET=http://10.10.10.177:5200/
VITE_MOCK_BASE_URL=http://10.10.10.177:5200/

VITE_DEV_API_BASE=http://10.10.10.177:5200
VITE_REAL_BASE_URL=http://10.10.10.177:5200/
VITE_APP_BASE_URL=http://10.10.10.177:5200/

# PC 后台内嵌 web-view 地址（同 Vite 根地址）
VITE_PC_ADMIN_ORIGIN=http://10.10.10.177:5200
VITE_H5_ENTRY_PC=false
VITE_H5_ENTRY_PC_HASH=/index

# ============================================================
# api-dev-bridge 配置（由 restart:pc-stack 启动，端口 3000）
# ============================================================
API_BRIDGE_PORT=3000
API_BRIDGE_BIND=0.0.0.0
API_BRIDGE_LAN_HOST=10.10.10.177

# mock = 本地种子数据（登录/首页/待办均返回 mock 数据，无需真实后端）
# real  = 转发上游（上游不可达时自动 fallback 到 mock）
API_BRIDGE_MODE=mock
API_UPSTREAM=http://120.24.48.102:5265/

API_BRIDGE_UPSTREAM_TIMEOUT=30000
API_BRIDGE_UPSTREAM_TIMEOUT_LONG=60000
API_BRIDGE_FALLBACK=true
API_BRIDGE_LOG_API=true
# 额外 CORS 白名单（逗号分隔 Origin），bridge 已对所有 10.* / 192.168.* 放行
# API_BRIDGE_CORS_WHITELIST=http://192.168.1.8:5173
