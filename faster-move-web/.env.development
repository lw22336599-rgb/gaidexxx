# 开发环境，VUE_APP_BASE_URL可以选择自己配置成需要的接口地址，如"https://api.xxx.com"
# 此文件修改后需要重启项目

# NODE_ENV禁止修改
NODE_ENV=development

# 真实后端（开发联调时与axios一致：先打 PC Vite:5200，由 dev proxy 转到 bridge 再转上游）
VITE_APP_BASE_URL=http://10.10.10.177:5200/
VITE_API_BASE=http://10.10.10.177:5200/

# === Mock 数据总开关（开发环境默认开启） ===
# true=本地 dev-bridge 提供 /seed/* + SSE 假数据；false=对接真实后端 VITE_API_BASE
VITE_USE_MOCK=true
# PC Vite 代理 → bridge：本机回环最稳（bridge 监听 0.0.0.0 时 127.0.0.1 必可达，避免误配局域网 IP 导致 502）
VITE_PROXY_TARGET=http://127.0.0.1:3000/
VITE_MOCK_API_BASE=http://10.10.10.177:3000
# PC Vite 绑定 0.0.0.0：局域网内用本机任意 IPv4 + :5200 访问
VITE_PC_DEV_BIND=0.0.0.0
