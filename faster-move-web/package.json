{
  "name": "alien",
  "version": "5.8.6",
  "description": "极狐",
  "main": "./src-electron/main.js",
  "private": true,
  "author": "jl/hjn",
  "scripts": {
    "dev": "cross-env VITE_CJS_IGNORE_WARNING=true vite",
    "build:win": "node build-with-release-notes.js",
    "build:win:original": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:web-resources": "rimraf dist && vite build && node build-web-resources.js",
    "dev:vue-tsc": "vue-tsc --noEmit && cross-env VITE_CJS_IGNORE_WARNING=true vite",
    "dev:https": "cross-env VITE_CJS_IGNORE_WARNING=true vite --config ./vite.config.dev.ts",
    "vue-tsc": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && cross-env VITE_CJS_IGNORE_WARNING=true vite build",
    "build:fast": "cross-env VITE_CJS_IGNORE_WARNING=true NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:report": "cross-env VITE_CJS_IGNORE_WARNING=true NODE_OPTIONS=--max-old-space-size=8192 vite build --config ./vite.config.dev.ts",
    "build:website": "cross-env VITE_CJS_IGNORE_WARNING=true NODE_OPTIONS=--max-old-space-size=8192 vite build --config ./vite.config.website.ts && node write.version.js",
    "build:vue-tsc": "vue-tsc --noEmit && cross-env VITE_CJS_IGNORE_WARNING=true vite build",
    "preview": "cross-env VITE_CJS_IGNORE_WARNING=true vite preview",
    "electron:serve": "electron .",
    "electron:build": "vite build && electron-builder",
    "lint:eslint": "eslint . --fix",
    "lint:prettier": "prettier {src,mock,library,types}/**/*.{html,vue,css,sass,scss,js,ts} --write",
    "lint:stylelint": "stylelint {src,mock,library}/**/*.{vue,css,sass,scss} --fix --cache --cache-location node_modules/.cache/stylelint/",
    "global:install": "npm i -g nrm cnpm npm-check-updates pnpm",
    "global:update": "ncu -g",
    "module:install": "pnpm i",
    "module:update": "ncu -u --reject vite-plugin-mock,eslint,vue-echarts,chokidar,@opentiny/vue && npm run module:install",
    "module:reinstall": "rimraf node_modules && npm run module:install",
    "git": "bash ./git.sh",
    "generate-pwa-assets": "pwa-assets-generator",
    "template": "plop",
    "release": "rm -rf ./build/oem/public/* && mv ./release/* ./build/oem/public/"
  },
  "build": {
    "productName": "极狐",
    "appId": "com.alien.admin",
    "copyright": "com.alien.admin © 2025",
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "frida-scripts/**"
    ],
    "forceCodeSigning": false,
    "directories": {
      "output": "release/fastermove/${version}"
    },
    "publish": {
      "provider": "generic",
      "url": "http://update.wmzdb.shop/windows",
      "updaterCacheDirName": "alien-updater",
      "useMultipleRangeRequest": false
    },
    "extraResources": [
      {
        "from": "./src/sunny_dll/SunnyNet64.dll",
        "to": "sunny_dll/SunnyNet64.dll"
      },
      {
        "from": "./src/sunny_dll/FsterDllService.dll",
        "to": "sunny_dll/FsterDllService.dll"
      }
    ],
    "nsis": {
      "oneClick": false,
      "guid": "极狐",
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./public/logo.ico",
      "uninstallerIcon": "./public/logo.ico",
      "installerHeaderIcon": "./public/logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "极狐",
      "differentialPackage": false,
      "include": "./build/installer.nsh"
    },
    "win": {
      "icon": "./public/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "alien-setup-${version}.${ext}",
      "requestedExecutionLevel": "requireAdministrator",
      "signAndEditExecutable": true,
      "forceCodeSigning": false,
      "signDlls": false
    },
    "mac": {
      "icon": "./public/logo.ico",
      "target": [
        "dmg"
      ],
      "extraResources": {
        "from": "./src/sunny_so",
        "to": "sunny_so"
      }
    },
    "linux": {
      "icon": "./public/logo.png",
      "category": "Network"
    },
    "files": [
      "dist/**",
      "src-electron/**",
      "SunnyNet/**",
      "frida-scripts/**"
    ]
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "@element-plus/icons-vue": "^2.3.1",
    "@kangc/v-md-editor": "^2.3.18",
    "@logicflow/core": "^2.2.1",
    "@logicflow/extension": "^2.2.1",
    "@lucky-canvas/vue": "^0.1.11",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@microsoft/signalr": "^10.0.0",
    "@opentiny/vue": "3.18.0",
    "@pureadmin/table": "^3.2.1",
    "@pureadmin/utils": "^2.6.0",
    "@types/dompurify": "^3.2.0",
    "@vueuse/core": "^12.2.0",
    "@vueuse/head": "^2.0.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "adm-zip": "^0.5.16",
    "axios": "^1.10.0",
    "benz-amr-recorder": "^1.1.5",
    "brotli": "^1.3.3",
    "color-name": "^2.0.0",
    "dayjs": "^1.11.13",
    "disable-devtool": "^0.3.8",
    "dompurify": "^3.2.6",
    "echarts": "^5.5.1",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "element-plus": "^2.9.1",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.6.3",
    "jsencrypt": "^3.3.2",
    "koffi": "^2.10.1",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.3.0",
    "pinyin-pro": "^3.26.0",
    "qs": "^6.13.1",
    "sortablejs": "^1.15.6",
    "ssh2": "^1.17.0",
    "sync-request": "^6.1.0",
    "typeit": "^8.8.7",
    "vsv-context-menu": "^1.4.2",
    "vsv-icon": "^1.2.2",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.0",
    "vue-echarts": "6.7.3",
    "vue-i18n": "^10.0.5",
    "vue-json-viewer": "^3.0.4",
    "vue-pdf-embed": "^2.1.1",
    "vue-qr": "^4.0.9",
    "vue-router": "^4.5.0",
    "vue3-gantt": "1.1.8-7",
    "vue3-puzzle-vcode": "^1.1.7",
    "xgplayer": "^3.0.20",
    "xgplayer-hls.js": "^3.0.20"
  },
  "devDependencies": {
    "@element-plus/eslint-config": "^2.8.5",
    "@koa/multer": "^3.1.0",
    "@types/brotli": "^1.3.4",
    "@types/lodash-es": "^4.17.12",
    "@types/nprogress": "^0.2.3",
    "@types/pako": "^2.0.3",
    "@types/qs": "^6.9.17",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/compiler-sfc": "^3.5.13",
    "@yll10243/vite-plugin-commonjs": "^1.0.0",
    "autoprefixer": "^10.4.20",
    "chokidar": "^3.6.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^4.0.0",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^8.18.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-prettier": "^5.2.4",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-vue": "^10.0.0",
    "javascript-obfuscator": "^4.1.1",
    "koa": "^2.16.0",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^13.0.1",
    "koa-static": "^5.0.0",
    "lint-staged": "^15.2.11",
    "mockjs": "^1.1.0",
    "pako": "^2.1.0",
    "picocolors": "^1.1.1",
    "plop": "^4.0.1",
    "png2icons": "^2.0.1",
    "postcss": "^8.4.49",
    "postcss-html": "^1.7.0",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "1.83.0",
    "stylelint": "^16.12.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "terser": "^5.37.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.5",
    "vite-plugin-banner": "^0.8.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-mock": "2.9.8",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-unplugin": "^1.8.0",
    "vite-plugin-vitebar": "^0.0.8",
    "vue-tsc": "^2.2.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "homepage": "https://vuejs-core.cn/shop-vite",
  "license": "Mozilla Public License Version 2.0",
  "lint-staged": {
    "*.{js,ts,vue}": [
      "npm run lint",
      "npm run lint:prettier",
      "git add"
    ]
  },
  "participants": [
    "FlowPeakFish"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxwk2024/shop-vite.git"
  }
}
